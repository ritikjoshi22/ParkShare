<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="3">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Owner Verification"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#00662e"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 4"
                android:textSize="12sp"
                android:textColor="#6F7A6E" />
        </LinearLayout>

        <!-- PROGRESS BAR -->
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progress="25"
            android:max="100"
            android:progressTint="#00662e"
            android:backgroundTint="#E2E2E5"
            android:layout_marginTop="16dp" />

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm your identity"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To start hosting your space on ParkIN, we need to verify your credentials."
            android:textSize="14sp"
            android:textColor="#6F7A6E"
            android:layout_marginTop="6dp"/>

        <!-- PAN INPUT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAN Number"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/panNumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Enter 10-digit PAN"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:maxLength="10"
            android:inputType="textCapCharacters" />

        <!-- UPLOAD CARDS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Citizenship (Front)"
            android:layout_marginTop="20dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:text="Upload Front Image" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Citizenship (Back)"
            android:layout_marginTop="12dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="81dp"
            android:text="Upload Back Image" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driving License"
            android:layout_marginTop="12dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="Upload Driving License" />

        <!-- SELFIE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selfie Verification"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_menu_camera"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retake Photo"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>

        <!-- CONSENT -->
        <CheckBox
            android:id="@+id/consent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I agree to verification terms"
            android:layout_marginTop="20dp"/>

        <!-- BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Save Draft"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="Continue"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>