<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- BOOKING LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="90dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        tools:listitem="@layout/item_parking" />

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <!-- ICON -->
        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_empty_parking"
            android:alpha="0.8"
            android:contentDescription="Empty state icon" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Parking Bookings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginTop="18dp" />

        <!-- DESCRIPTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You haven’t booked any parking yet. Explore nearby spaces and reserve your spot in seconds."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplore"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Explore Parking"
            android:textAllCaps="false"
            android:layout_marginTop="22dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/primary"
            android:paddingStart="26dp"
            android:paddingEnd="26dp" />

    </LinearLayout>

</FrameLayout>